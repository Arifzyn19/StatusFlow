# StatusFlow — environment template
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=production
PORT=3001
HOST=127.0.0.1

# Frontend URL (for CORS)
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ADMIN_EMAIL=admin@statusflow.local
ADMIN_PASSWORD=ChangeMe123!
SESSION_COOKIE_NAME=statusflow_session
COOKIE_SECURE=false

# Database (SQLite file; PostgreSQL-ready via repository layer)
DATABASE_URL=file:./data/statusflow.db

# WhatsApp sessions (secure server-side dir, chmod 700)
SESSION_DIRECTORY=./data/sessions

# Uploads / video
TEMP_UPLOAD_DIRECTORY=./data/temp
MAX_UPLOAD_SIZE_MB=128
MAX_VIDEO_DURATION_SECONDS=90
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_FFMPEG=1
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/webm
UPLOAD_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=info
